# ─────────────────────────────────────────────────────────────
# RepoLens frontend — environment variables (Vite)
# Copy this file to `.env.local` and change values if needed.
# NEVER put secrets here: every VITE_* value ends up in the browser.
# ─────────────────────────────────────────────────────────────

# Where the Spring Boot backend runs (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080

# true  = use fake answers from Mock Service Worker (no backend needed)
# false = talk to the real backend at VITE_API_BASE_URL
# Mocks only ever run in the dev server (`npm run dev:mock`); production builds ignore this flag.
VITE_USE_MOCKS=false
