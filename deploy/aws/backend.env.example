# /opt/repolens/.env on the server — production settings. NEVER commit the filled-in copy.

# ── Database: Supabase → Project Settings → Database → Connection string → "Session pooler"
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_POOL_SIZE=5

# ── Security: generate NEW values, do not reuse the ones from your laptop
#   openssl rand -base64 48   → JWT_SECRET
#   openssl rand -base64 32   → GITHUB_TOKEN_KEY
JWT_SECRET=
GITHUB_TOKEN_KEY=

# ── Where things live
FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
STORAGE_ROOT=/opt/repolens/storage
FORWARD_HEADERS_STRATEGY=native
DEV_TOOLS_ENABLED=false

# ── AI (Ollama on this same machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# ── GitHub OAuth App for PRODUCTION (callback: https://YOUR-APP.vercel.app/integrations/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google OAuth client (redirect URI below must be added in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://API_DOMAIN/login/oauth2/code/google
