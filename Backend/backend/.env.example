# Backend secrets and local overrides. Copy to `.env` (gitignored) — Spring Boot reads it on start.
# Real environment variables always win over this file. Never commit real values.

# ── AI (chat + code review) ─────────────────────────────────────────────
# Chat, review and embeddings all run on local Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# ── GitHub sign-in + private repo import (OAuth App) ────────────────────
# github.com/settings/developers → OAuth Apps
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/integrations/github/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
# REQUIRED. 32-byte base64 key that encrypts stored GitHub tokens:  openssl rand -base64 32
# Changing it later makes already-connected GitHub accounts reconnect.
GITHUB_TOKEN_KEY=

# ── Google sign-in (OAuth 2.0 web client) ───────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized JavaScript origins: http://localhost:5173
#   Authorized redirect URI:       http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ── Security ────────────────────────────────────────────────────────────
# REQUIRED. Signs login tokens (≥32 chars):  openssl rand -base64 48
JWT_SECRET=

# ── Developer tools ─────────────────────────────────────────────────────
# Swagger UI (/swagger-ui.html) and /api/ai/test-* debug endpoints. Off unless set; never enable in production.
DEV_TOOLS_ENABLED=true

# ── Infrastructure (defaults match docker-compose.yml) ──────────────────
# DB_URL=jdbc:postgresql://localhost:5432/repolens
# DB_USERNAME=repolens
# DB_PASSWORD=repolens
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
